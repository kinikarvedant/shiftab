# Copy to your service's environment (never commit real values).
NODE_ENV=production
# >= 32 chars. Encrypts PIN keys, 2FA secrets and pay rates. Back it up separately.
APP_SECRET=
DATA_DIR=./data
PORT=8080
HOST=127.0.0.1
# Set when running behind a reverse proxy (Caddy/nginx) so rate limits see real client IPs.
TRUST_PROXY=1
# Optional fixed first-run setup code (otherwise random and printed in the log).
SETUP_CODE=
